            a.speed = random_range(0.5,5);
            a.direction = irandom(360);
            a.sprite_index = choose(sprBulletKunai,sprBulletArrowhead,sprPCircle,sprBulletDot,sprPBigArrowhead);
            a.image_index = irandom(a.image_number-1);

