        alarm[0] = 3;
    break;
    case 2:
        var a = instance_create(x + (sprite_width/2) * choose(-1,1), y - sprite_height/2, objColonelBulletWrap);
        a.speed = random_range(3,5);
        a.direction = 270 + irandom_range(-80,80);

        alarm[0] = 9;
    break;
