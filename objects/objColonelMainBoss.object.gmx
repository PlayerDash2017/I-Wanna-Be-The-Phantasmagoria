            <kind>1</kind>
            <string>if (!instance_exists(Plat)){
    Plat = instance_create(x,y,objPlatform);
    Plat.speed = 3;
    Plat.direction = 270 + choose(-1,1) * 30;
}

if (extraPhase){
    var a = instance_create_battle(irandom(battle_width), 0, objColonelBulletMargot);
    a.speed = random_range(2,3);
    a.direction = 270 + irandom_range(-10,10);
    a.image_index = irandom(2);

    alarm[0] = 8;
    exit;
}

switch (HP) {
    case 5:
        var a = instance_create(x + irandom(sprite_width/2)*choose(-1,1), y + irandom(sprite_height/2)*choose(-1,1), objColonelBullet);
        a.speed = random_range(2,4);
        a.direction = irandom(360);
        a.sprite_index = sprBulletDot;
        a.image_blend = make_color_hsv(random(255), 255, 255);

        alarm[0] = 4;
    break;
    case 4:
        var a = instance_create_battle(battle_width/2, battle_height/2, objColonelBulletCenter);
        a.speed = 7;
        a.direction = irandom(360);

        alarm[0] = 4;
    break;
