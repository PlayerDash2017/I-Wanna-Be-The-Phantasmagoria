          <argument>
            <kind>1</kind>
            <string>if (extraPhase){
    alarm[0] = -1;
    alarm[1] = -1;
    image_angle = 360 * choose(-1,1);

    var A = scrGetPlayerID();
    with(objColonelBulletMargot){
        if (A == scrGetPlayerID()){
            instance_destroy();
        }
    }
}

switch (HP) {
    case 3: // Red Colonel
        alarm[1] = 1;
        image_index = 1;
    break;
    case 2:
        image_index = 1;
    break;
    case 1: // Final Colonel
        var A = scrGetPlayerID();
        with(objColonelBulletWrap){
            if (scrGetPlayerID() == A){
                Bye = true;
                speed = 9;
                direction = point_direction(scrPX(), scrPY(), x, y);
            }
        }
        image_index = 2;
    break;
    case 0:
        var A = scrGetPlayerID();
        with(objColonelBullet){
            if (scrGetPlayerID() == A) instance_destroy();
        }
        with(Plat){
            if (scrGetPlayerID() == A) instance_destroy();
        }

        instance_destroy();
    break;
}

alarm[0] = 50;</string>
