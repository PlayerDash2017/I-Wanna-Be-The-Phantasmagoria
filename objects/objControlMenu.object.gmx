<object>
  <spriteName>&lt;undefined&gt;</spriteName>
  <solid>0</solid>
  <visible>-1</visible>
  <depth>0</depth>
  <persistent>0</persistent>
  <parentName>&lt;undefined&gt;</parentName>
  <maskName>&lt;undefined&gt;</maskName>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>select = 0;
playerID = 0;

xMargin = 120;
yStep = 40;

settingButton = false;
showResetPrompt = false;

//Add two for the &quot;Controller index&quot; and &quot;Reset controls&quot; lines
numberOfButtons = KEY.NUMBER + 3;
buttonName = scrControls(&quot;getControlNameArray&quot;);

event_user(0);
buttonName[numberOfButtons - 1] = &quot;Reset Controls&quot;;
bindName[numberOfButtons - 1] = &quot;&quot;;

if (bindName[0] == &quot;-1&quot;) bindName[0] = &quot;Keyboard&quot;;

animationTime = 0;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="2" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Stop reset prompt
showResetPrompt = false;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (!settingButton)
{
    //Not currently rebinding a key, navigate options
    if (scrButtonCheckPressed(KEY.MENU_BACK))
    {
        //Save changes and go back
        scrSaveConfig();
        instance_create(x, y, objOptionsMenu);
        instance_destroy();
    }
    
    if (scrButtonCheckPressed(KEY.MENU_OPTIONS))
    {
        //Save changes and go back
        scrSaveConfig();
        global.menuSelectPrev[1] = 0;
        if (!global.gameStarted)
        {
            room_goto(rMenu);
        }
        else
        {
            instance_destroy();
        }
        exit;
    }
    
    var vInputPressed = scrButtonCheckPressed(KEY.MENU_DOWN) - scrButtonCheckPressed(KEY.MENU_UP);
    if (vInputPressed != 0)
    {
        //Move to next/previous option
        audio_play_sound(global.menuSound, 0, false);
        select += vInputPressed;
        select = scrWrapInRange(select, 0, numberOfButtons - 1);
    }
    
    if (scrButtonCheckPressed(KEY.MENU_ACCEPT))
    {
        if (select &gt;= 2)
        {
            //Select current option
            if (select != numberOfButtons - 1)
            {
                //Start rebinding
                settingButton = true;
            }
            else
            {
                //Reset controls
                scrControls(&quot;setControlDefault&quot;);
                
                showResetPrompt = true;
                alarm[0] = 60;
            }
        }
    }
    
    var hInputPressed = scrButtonCheckPressed(KEY.MENU_RIGHT) - scrButtonCheckPressed(KEY.MENU_LEFT);
    if (hInputPressed != 0)
    {   
        //Change controller index
        if (select == 0)
        {
            global.controllerIndex[playerID] += hInputPressed;
            global.controllerIndex[playerID] = scrWrapInRange(global.controllerIndex[playerID], -1, 11);

            scrControls(&quot;setMenuControl&quot;);
        }
        else if (select == 1)
        {
            playerID += hInputPressed;
            playerID = scrWrapInRange(playerID, 0, 1);
        }
    }
}
else
{
    //Wait for new bind
    if (global.controllerIndex[playerID] == -1 || !gamepad_is_connected(global.controllerIndex[playerID]))//Keyboard
    {
        if (keyboard_check_pressed(vk_anykey))
        {
            //Bind new key
            var newKey = keyboard_key;
            if (newKey == 160 || newKey == 161)
            {
                //If a shift key was pressed, make both shift keys work
                newKey = vk_shift;
            }
            
            global.controls[select-2, playerID] = newKey;
            settingButton = false;
        }
    }
    else//Controller
    {
        var newButton = scrAnyControllerButton(playerID);
        if (newButton != -1)
        {                                          
            //Bind new key
            global.controls[select-2, playerID] = newButton;
            settingButton = false;
        }
    }
}

//Get current controls
event_user(0);

if (bindName[0] == &quot;-1&quot;) bindName[0] = &quot;Keyboard&quot;;

animationTime++;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="7" enumb="10">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Update current binds

bindName[0] = string(global.controllerIndex[playerID]);
bindName[1] = playerID + 1;
for (var i = 0; i &lt; numberOfButtons - 3; i++)
{
    //show_debug_message(i);
    var getName = scrGetControllerBind(global.controls[i, playerID]);
    //show_debug_message(getName)
    bindName[i+2] = scrTernary(getName == &quot;Unknown&quot;,scrGetKeybind(global.controls[i, playerID]),getName);//scrGetControllerBind(global.controls[i, playerID]);
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>draw_set_color(scrTernary(!global.gameStarted, c_black, c_white));
draw_set_valign(fa_top);
draw_set_font(fDefault24);

yStart = (608 - numberOfButtons * yStep)/2;
currentSlot = 0;

for(var i = 0; i &lt; numberOfButtons; i += 1)
{
    var bindText = bindName[i];
    if (i == select &amp;&amp; settingButton)
    {
        bindText = &quot;Press button to set&quot;;
    }
    else if (showResetPrompt &amp;&amp; i == numberOfButtons - 1)
    {
        bindText = &quot;Controls reset!&quot;;
    }
    scrDrawOption(buttonName[i], bindText);
    
    draw_sprite(sprPlayerIdle, animationTime/5, xMargin - 16, yStart + (yStep * select) + 21);
}

if (global.controllerIndex[playerID] != -1)
{
    //Display currently connected controller
    draw_set_color(c_maroon);
    draw_set_font(fDefault12);
    draw_set_halign(fa_middle);
    draw_set_valign(fa_middle);
    
    var controllerText = &quot;Current controller: &quot;;
    
    if (gamepad_is_connected(global.controllerIndex[playerID]))
    { 
        controllerText += gamepad_get_description(global.controllerIndex[playerID]);
    }
    else
    {
        controllerText += &quot;None&quot;;
    }
    
    scrDrawTextOutline(400, 48, controllerText, c_white, c_black);
    
    draw_set_color(c_black);
}

scrDrawButtonInfo(false);
</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
  <PhysicsObject>0</PhysicsObject>
  <PhysicsObjectSensor>0</PhysicsObjectSensor>
  <PhysicsObjectShape>0</PhysicsObjectShape>
  <PhysicsObjectDensity>0.5</PhysicsObjectDensity>
  <PhysicsObjectRestitution>0.100000001490116</PhysicsObjectRestitution>
  <PhysicsObjectGroup>0</PhysicsObjectGroup>
  <PhysicsObjectLinearDamping>0.100000001490116</PhysicsObjectLinearDamping>
  <PhysicsObjectAngularDamping>0.100000001490116</PhysicsObjectAngularDamping>
  <PhysicsObjectFriction>0.200000002980232</PhysicsObjectFriction>
  <PhysicsObjectAwake>-1</PhysicsObjectAwake>
  <PhysicsObjectKinematic>0</PhysicsObjectKinematic>
  <PhysicsShapePoints/>
</object>
