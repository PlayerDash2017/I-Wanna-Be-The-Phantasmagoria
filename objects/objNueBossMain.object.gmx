        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>var A = scrGetPlayerID();
with(objNueBullet){
    if (A == scrGetPlayerID())
        { Dis = true; }
}

with(objNueSpinSpawn){
    if (ID == other.id) instance_destroy();
}

with(objNueCircleSpawn){
    if (A == scrGetPlayerID()) instance_destroy();
}

iframes = 100;
alarm[0] = 100;</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="7" enumb="12">
      <action>
        <libid>1</libid>
