        <codestring/>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments/>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <exetype>2</exetype>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <functionname/>
        <codestring/>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>BossType = "Nue";
enemyRepeat = 1;
iframeMax = 50;

image_speed = 1/5;
alarm[0] = 75;

block = id;
var A = scrGetPlayerID();
with(objNueBlockStart){
    if (A == scrGetPlayerID()){
        other.block = id;
    }
}</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <exetype>2</exetype>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <functionname/>
        <codestring/>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>draw_sprite_ext(sprite_index,-1,x,y,image_xscale,image_yscale,0,c_white,1 - (iframes != 0) * 0.5);</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="2" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <exetype>2</exetype>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <functionname/>
        <codestring/>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (instance_exists(block)){
    instance_destroy(block);
    
    var A = scrGetPlayerID();
    with(objPlayer){
        if (PlayerID == A){
            botState = "InfJump";
        }
    }
    
    global.infJump[scrGetPlayerID()] = true;
}

switch (HP)
{
    case 5:
        var a = instance_create_battle(0,irandom_range(32,battle_height-32),objNueBullet);
        a.hspeed = random_range(2,4);
        
        var a = instance_create_battle(battle_width,irandom_range(32,battle_height-32),objNueBullet);
        a.hspeed = -random_range(2,4);
        a.image_index = 1;
        
        alarm[0] = 20;
    break;
    case 4:
        for (var i = 0; i &lt; 360; i += 180)
        {
            var a = instance_create(x,y,objNueSpinSpawn);
            a.Angle = i;
            a.ID = id;
        }
    break;
    case 3:
        var Ran = irandom(360);
        for (var i = 0; i &lt; 360; i += 360/5)
        {
            a = instance_create(x,y,objNueBullet3);
            a.direction = i + Ran;
            a.speed = 2;
        }
        
        alarm[0] = 15;
    break;
    case 2:
        var Ran = irandom_range(-30,30);
        for (var i = 0; i &lt;= 180; i += 180/8)
        {
            a = instance_create(x,y,objNueBullet5);
            a.speed = 4;
            a.direction = -90 + i + Ran
        }
        
        alarm[0] = 25;
    break;
    /*case 2:
        instance_create(x,y,objNueCircleSpawn);
        
        alarm[0] = 75;
    break;*/
}</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="7" enumb="10">
      <action>
        <libid>1</libid>
        <id>603</id>
