    <event eventtype="8" enumb="64">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>var i = 0;

repeat(2)
{
    //HP Bar
    for (var j = 0; j &lt; 5; j ++)
    {
        var xDraw = (640 * i) + 300 + j*16;
        var yDraw = 100;

        if (global.playerHP[i] == 1)
            { xDraw += irandom_range(-1,1); yDraw += irandom_range(-1,1); }

        draw_sprite_ext(sprHUDHP, global.playerHP[i]-1 &lt; j, xDraw, yDraw,
                        1,1, lengthdir_y(8, current_time/10),merge_colour(c_red, c_aqua, i),1);
    }

    //Magic Bar
    var Magic = global.playerMagic[i];
    var Color = merge_colour(c_black,c_aqua,1 - (Magic &lt;= 50) * 0.5);
    if (Magic == 100) Color = c_orange;
    draw_healthbar(640 * i,0,(640 * i) + 100,20,Magic,c_black,Color,Color,0,true,true);

    var Charge = global.playerCharge[i];
    draw_healthbar(640 * i,0,(640 * i) + 100,20,Charge,c_black,c_white,c_white,0,false,false);
    
    draw_set_font(fDefault12);
    draw_set_halign(fa_left);
    scrDrawTextOutline(640 * i + 110,5,string(floor(Magic))+&quot;%&quot;,c_white,c_black);

    i = 1;
}</string>
          </argument>
        </arguments>
      </action>
    </event>
