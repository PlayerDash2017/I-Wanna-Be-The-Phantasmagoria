        <arguments>
          <argument>
            <kind>1</kind>
            <string>var j = 0;
var i = 1;//Player 1 View
var Color = c_red;
repeat(2)
{
    repeat(5)
    {
        draw_rectangle_colour(view_xview[i]+j, view_yview[i]+j,
                       view_xview[i]+view_wview[i]-1-j, view_yview[i]+view_hview[i]-1-j,
                       Color,merge_colour(Color,c_white,0.5),Color,merge_colour(Color,c_white,0.5),
                       true);

        j ++;
    }

    Color = c_blue;
    i = 2;//Player 2 View
    j = 0;
}</string>
          </argument>
        </arguments>
      </action>
    </event>
