        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>alarm[0] = 1;

image_alpha -= 0.01;
if (image_alpha &lt;= 0)
    { instance_destroy(); }</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
  <PhysicsShapePoints/>
