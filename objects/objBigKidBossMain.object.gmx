        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Create a fruit

var hpMin;
hpMin[0] = 3;
hpMin[1] = 1;

for (var i = 0; i &lt;= 1; i ++) {
    if (!instance_exists(Bounce[i]) &amp;&amp; HP &lt;= hpMin[i]){
        Bounce[i] = instance_create(x, y, objBigKidBounce);
        Bounce[i].direction = 45 + 90*irandom(3);
        Bounce[i].speed = 3 + i*0.5;
        Bounce[i].ID = id;

        audio_play_sound(sndShoot, 0, false);
        //show_debug_message(&quot;Cherry Bounce: &quot;+string(i))
        //show_debug_message(HP);
    }
}</string>
