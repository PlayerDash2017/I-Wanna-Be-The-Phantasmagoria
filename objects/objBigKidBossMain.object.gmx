            <kind>1</kind>
            <string>/// Create a fruit&#xd;
&#xd;
var hpMin;&#xd;
hpMin[0] = 3;&#xd;
hpMin[1] = 1;&#xd;
&#xd;
for (var i = 0; i &lt;= 1; i ++) {&#xd;
    if (!instance_exists(Bounce[i]) &amp;&amp; HP &lt;= hpMin[i]){&#xd;
        Bounce[i] = instance_create(x, y, objBigKidBounce);&#xd;
        Bounce[i].direction = 45 + 90*irandom(3);&#xd;
        Bounce[i].speed = 3 + i*0.5;&#xd;
        Bounce[i].ID = id;&#xd;
&#xd;
        audio_play_sound(sndShoot, 0, false);&#xd;
        //show_debug_message("Cherry Bounce: "+string(i))&#xd;
        //show_debug_message(HP);&#xd;
    }&#xd;
}</string>
