        <arguments>
          <argument>
            <kind>1</kind>
            <string>switch (HP) {
    case 3: case 1:
        alarm[1] = 1;
    break;
    case 0:
        var a = instance_place(x, y+5, objBigKidBody);
        instance_destroy(a);

        var A = scrGetPlayerID();
        with(objSpikeUp){
            if (A == scrGetPlayerID())
                { instance_destroy(); }
        }
        with(objBigKidCherry){
            if (A == scrGetPlayerID())
                { instance_destroy(); }
        }
        with(objBigKidBounce){
            if (A == scrGetPlayerID())
                { instance_destroy(); }
        }
        with(objBigKidWater){
            if (A == scrGetPlayerID())
                { instance_destroy(); }
        }
        with(objBigKidBigBullet){
            if (A == scrGetPlayerID())
                { instance_destroy(); }
        }

        instance_destroy();
    break;
}</string>
