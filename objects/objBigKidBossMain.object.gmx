        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (!spikeStart){
    spikeStart = true;
    for (var i = 32; i &lt; 640-32; i += 32)
    {
        instance_create_battle(i,384,objSpikeUp);
    }
}

var a = instance_create_battle(irandom_range(32,252), 0, objBigKidCherry);
a.vspeed = 3;

if (HP &lt;= 4){
    var a = instance_create_battle(irandom_range(32,252), battle_height, objBigKidCherry);
    a.vspeed = -4;
}

if (HP &lt;= 2){
    var a = instance_create_battle(battle_width, irandom_range(64,battle_height-96), objBigKidCherry);
    a.hspeed = -5;
}

alarm[0] = 60;</string>
