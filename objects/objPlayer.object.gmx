        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Killer collision&#xd;
&#xd;
var killer = instance_place(x, y, objPlayerKiller)&#xd;
if (killer != noone)&#xd;
{&#xd;
    scrKillPlayer();&#xd;
}&#xd;
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname/>
        <codestring/>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Screen border death, player animation

if ((bbox_right &lt; 0 || bbox_left > room_width || bbox_bottom &lt; 0 || bbox_top > room_height) &amp;&amp; global.edgeDeath)
{
    scrKillPlayer();
}


var notOnBlock = (place_free(x, y + global.grav));
var onVineR = (place_meeting(x + 1, y, objVineR) &amp;&amp; notOnBlock);
var onVineL = (place_meeting(x - 1, y, objVineL) &amp;&amp; notOnBlock);

if (!onVineR &amp;&amp; !onVineL)   //Not touching any vines
{
    if (onPlatform || !notOnBlock)  //Standing on something
    {
        //Check if moving left/right
        var L = scrTernary(!botMode,scrButtonCheck(KEY.LEFT,PlayerID) || (global.directionalTapFix &amp;&amp; scrButtonCheckPressed(KEY.LEFT,PlayerID)),botKey[KEY.LEFT]);
        var R = scrTernary(!botMode,scrButtonCheck(KEY.RIGHT,PlayerID) || (global.directionalTapFix &amp;&amp; scrButtonCheckPressed(KEY.RIGHT,PlayerID)),botKey[KEY.RIGHT]);
        
        if ((L || R) &amp;&amp; !frozen)
        {
            sprite_index = scrPlayerSprite("Run");
            image_speed = 1/2;
        }
        else
        {
            sprite_index = scrPlayerSprite("Idle");
            image_speed = 1/5;
        }
    }
    else    //In the air
    { 
        if ((vspeed * global.grav) &lt; 0)
        {
            sprite_index = scrPlayerSprite("Jump");
            image_speed = 1/2;
        }
        else
        {
            sprite_index = scrPlayerSprite("Fall");
            image_speed = 1/2;
        }
    }
}
else    //Touching a vine
{
    sprite_index = sprPlayerSlide;
    image_speed = 1/2;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event enumb="0" eventtype="3">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname/>
        <codestring/>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Player actions and movement

iframes = max(iframes - 1,0);

botKey[KEY.LEFT] = false;
botKey[KEY.RIGHT] = false;
botKey[KEY.JUMP] = false;
botKey[KEY.SHOOT] = false;
if (botMode &amp;&amp; !frozen &amp;&amp; instance_number(objBossParent) >= 2){
    var bossParent = instance_nearest(x, y, objBossParent);
    var bulletParent = instance_nearest(x, y, objPlayerKiller);
    var yPlayer = y - 800;
    var xPlayer = x - PlayerID*1280;

    botReleaseShoot = false;
    botJumpTime = max(botJumpTime - 1,0);
    
    //BigKid
    if (botState == "BigKid_Init"){
        if (yPlayer >= 264){
            if (botJumpTime &lt;= 0){
                botKey[KEY.JUMP] = true;
                botJumpTime = 20;
                botReleaseJump = false;
                //scrPrint("Salta");
            }
        } else {
            botState = "BigKid_Step";
        }
        
        if (xPlayer &lt; 128) botKey[KEY.RIGHT] = true;
        else if (xPlayer > 135) botKey[KEY.LEFT] = true;
    } else {
    
    if (bulletParent != noone){
        var bulletDis = point_distance(x, y, bulletParent.x, bulletParent.y);
        
        if (bulletDis &lt; botDistance){
            if (place_free(x-20, y) &amp;&amp; place_free(x+20, y))
            {
                if ((bulletParent.x - x) > 0)
                    { botKey[KEY.LEFT] = true; }
                else
                    { botKey[KEY.RIGHT] = true; }
            } else {
                if (place_meeting(x-20, y, objBlock)) botKey[KEY.RIGHT] = true;
                else botKey[KEY.LEFT] = true;
            }
            
            //BigKid
            if (botState == "BigKid_Step"){
                var bulletKiller = instance_nearest(x,y,objBigKidBigBullet);
                
                if (bulletKiller != noone){
                    var bigBulletDis = point_distance(x, y, bulletKiller.x, bulletKiller.y);
                    if (bigBulletDis &lt;= 96){
                        botKey[KEY.RIGHT] = true;
                        botKey[KEY.JUMP] = true;
                    }
                }
                
                if (xPlayer > 160){
                    botKey[KEY.RIGHT] = false;
                    botKey[KEY.LEFT] = true;
                }
            }
            
            botReleaseJump = false;
            if (abs(bulletParent.y - y) &lt; 20){
                if (bulletParent.y - y > -10 &amp;&amp; botJumpTime &lt;= 0){
                    botKey[KEY.JUMP] = true;
                    botJumpTime = 10;
                }

                if (bulletParent.y - y &lt; 0 &amp;&amp; vspeed &lt; 0){
                    botReleaseJump = true;
                }
            }
            
            if (sign(bossParent.x - x) == xScale){
                if ((global.count mod 3) == 0 &amp;&amp; irandom(10) == 0){
                    botReleaseShoot = true;
                    botKey[KEY.SHOOT] = true;
                    botCharge = (irandom(5) == 0);
                }
            }
        } else {
            //Shiratama
            if (botState == "Destination"){
                bossParent = instance_nearest(x,y,objShiratamaSpike);
            }
            
            if (sign(bossParent.x - x) != xScale){
                if (bossParent.x > x) botKey[KEY.RIGHT] = true;
                else botKey[KEY.LEFT] = true;
            } else {
                if ((global.count mod 3) == 0 &amp;&amp; irandom(3) == 0){
                    botReleaseShoot = true;
                    botKey[KEY.SHOOT] = true;
                    botCharge = (irandom(3) == 0);
                }
            }
            
            if (botState == "InfJump"){
                var bossH = bossParent.sprite_width/2 - bossParent.sprite_xoffset;
                if (y > bossParent.y+bossH &amp;&amp; botJumpTime == 0){
                    botKey[KEY.JUMP] = true;
                    botJumpTime = 10;
                }
                
                var yPlayer = y - 800;
                if (yPlayer > battle_height-32){
                    //scrPrint("Salta?");
                    botKey[KEY.JUMP] = true;
                }
            }
        }
        
        if (place_meeting(x,y+1,objWater2) &amp;&amp; botJumpTime &lt;= 0){
            botJumpTime = 5;
            botKey[KEY.JUMP] = true;
        }
    }}
    
    //BigKid
    if (botState == "BigKid_Step"){
        var yPlayer = y - 800;
        
        if (yPlayer > 288){
            botKey[KEY.JUMP] = true;
        }
        
        if (!place_free(x,y+1))
            { botState = "BigKid_Init"; }
    }
    
    //Hatsune Miku
    if (botState == "Miku_NoFloor"){
        var yPlayer = y - 800;
        var xPlayer = x - PlayerID*1280;
        
        botKey[KEY.RIGHT] = false;
        botKey[KEY.LEFT] = false;
        botKey[KEY.JUMP] = false;
        botReleaseJump = false;
        if (yPlayer > 352){
            //Se va fuera del bloque
            if (xPlayer > 176){
                botKey[KEY.RIGHT] = true;
            } else {
                botKey[KEY.LEFT] = true;
            }
            
            //Salta
            if ((xPlayer &lt;= 80 || xPlayer >= 272) &amp;&amp; botJumpTime == 0){
                botKey[KEY.JUMP] = true;
                botJumpTime = 10;
            }
        } else {
            
            //Se va a la plataforma
            if (xPlayer &lt;= 96){
                botKey[KEY.RIGHT] = true;
            } else if (xPlayer >= 256){
                botKey[KEY.LEFT] = true;
            } else {
                botState = "Miku_OnFloor";
            }
            
            //Salta
            if (botJumpTime == 0){
                botKey[KEY.JUMP] = true;
                botJumpTime = 10;
            }
        }
    }
    
    if (botState == "Miku_OnFloor"){
        var xPlayer = x - PlayerID*1280;
        
        if (xPlayer &lt;= 96){
            botKey[KEY.RIGHT] = true;
        } else if (xPlayer >= 256){
            botKey[KEY.LEFT] = true;
        }
    }
}

//Left-right input
var L = scrTernary(!botMode,scrButtonCheck(KEY.LEFT,PlayerID) || (global.directionalTapFix &amp;&amp; scrButtonCheckPressed(KEY.LEFT,PlayerID)),botKey[KEY.LEFT]);
var R = scrTernary(!botMode,scrButtonCheck(KEY.RIGHT,PlayerID) || (global.directionalTapFix &amp;&amp; scrButtonCheckPressed(KEY.RIGHT,PlayerID)),botKey[KEY.RIGHT]);
var h = 0;
if (!frozen)
    { h = -(L || R) + (2 * R); }

var ice = instance_place(x, y + global.grav, objIceBlock);
var notOnBlock = place_free(x, y + global.grav);
var onVineL = (place_meeting(x - 1, y, objVineL) &amp;&amp; notOnBlock);
var onVineR = (place_meeting(x + 1, y, objVineR) &amp;&amp; notOnBlock);

//Horizontal movement
if (h != 0)    //Moving
{
    xScale = h;
    if ((h == -1 &amp;&amp; !onVineR) || (h == 1 &amp;&amp; !onVineL))
    {
        if (ice == noone)    //Normal movement
            { hspeed = runSpeed * h; }
        else    //Ice movement
        {
            hspeed += (ice.slip) * h;
            
            if (abs(hspeed) > runSpeed)
                hspeed = runSpeed * h;
        }
    }
}
else    //Not moving
{
    if (ice == noone)    //Normal movement
        hspeed = 0;
    else    //Ice movement
    {
        if (hspeed > 0)
            { hspeed -= min(ice.slip, abs(hspeed)); }
        else if (hspeed &lt; 0)
            { hspeed += min(ice.slip, abs(hspeed)); }
    }
}

onPlatform = false;
with(objPlatform)
{
    if (place_meeting(x, y-global.grav, other))
    {
        if ((global.grav == 1 &amp;&amp; other.bbox_bottom &lt;= bbox_top &amp;&amp; other.vspeed >= vspeed) || (global.grav == -1 &amp;&amp; other.bbox_top >= bbox_bottom &amp;&amp; other.vspeed &lt;= vspeed))
        {
            other.onPlatform = true;
        }
    }
}

var conveyor = instance_place(x,y + (global.grav), objConveyor);
if (conveyor != noone)
{
    hspeed += conveyor.h;
}

if (global.grav * vspeed > maxVspeed)
{
    vspeed = global.grav * maxVspeed;
}

if (!frozen)
{
    if (scrTernary(!botMode,scrButtonCheckPressed(KEY.SHOOT,PlayerID),botKey[KEY.SHOOT]))
        scrPlayerShoot();
    if (scrTernary(!botMode,scrButtonCheckPressed(KEY.JUMP,PlayerID),botKey[KEY.JUMP]))
        scrPlayerJump();
    if (scrButtonCheckReleased(KEY.JUMP,PlayerID) || botReleaseJump)
        scrPlayerReleaseJump();
    
    // Magic
    if (scrTernary(!botMode,scrButtonCheck(KEY.SHOOT, PlayerID),botCharge)){
        global.playerCharge[PlayerID] = min(global.playerCharge[PlayerID] + 1,global.playerMagic[PlayerID]);

        if (global.playerCharge[PlayerID] == 10 &amp;&amp; preCharge != global.playerCharge[PlayerID])
            { chargeSound = audio_play_sound(sndCharge, 0, false); }
        preCharge = global.playerCharge[PlayerID];
    } else {
        scrPlayerMagic();
    }
    //if (scrButtonCheckPressed(KEY.SUICIDE,PlayerID))
    //    scrKillPlayer();
}

if (global.adAlign &amp;&amp; !place_free(x, y + (global.grav)) &amp;&amp; !frozen)
{
    if (scrButtonCheckPressed(KEY.ALIGN_LEFT)) {hspeed -= 1;}
    if (scrButtonCheckPressed(KEY.ALIGN_RIGHT)) {hspeed += 1;}
}
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname/>
        <codestring/>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Vines                                            &#xd;
&#xd;
if (onVineL || onVineR)&#xd;
{&#xd;
    if (onVineR)&#xd;
        { xScale = -1; }&#xd;
    else&#xd;
        { xScale = 1; }&#xd;
    &#xd;
    vspeed = 2 * global.grav;&#xd;
    &#xd;
    //Try to leave vine&#xd;
    if (onVineL &amp;&amp; scrButtonCheckPressed(KEY.RIGHT)) || (onVineR &amp;&amp; scrButtonCheckPressed(KEY.LEFT))&#xd;
    {&#xd;
        if (scrButtonCheck(KEY.JUMP))    //Jumping off&#xd;
        {&#xd;
            if (onVineR)&#xd;
                { hspeed = -15; }&#xd;
            else&#xd;
                { hspeed = 15; }&#xd;
            vspeed = -9 * global.grav;&#xd;
            audio_play_sound(sndWallJump, 0, false);&#xd;
        }&#xd;
        else    //Falling off&#xd;
        {&#xd;
            if (onVineR)&#xd;
                { hspeed = -3; }&#xd;
            else&#xd;
                { hspeed = 3; }&#xd;
        }&#xd;
    }&#xd;
}&#xd;
&#xd;
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname/>
        <codestring/>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Slopes         &#xd;
&#xd;
if (instance_exists(objSlope) &amp;&amp; hspeed != 0)&#xd;
{&#xd;
    var moveLimit = abs(hspeed);    //Sets how high/low the player can go to snap onto a slope, this can be increased to make the player able to run over steeper slopes (ie setting it to abs(hspeed)*2 allows the player to run over slopes twice as steep)&#xd;
    &#xd;
    var slopeCheck;&#xd;
    var hTest;&#xd;
    &#xd;
    var ySlope;&#xd;
    &#xd;
    //falling onto a slope&#xd;
    if (place_meeting(x+hspeed, y+vspeed+gravity, objSlope) &amp;&amp; (vspeed+gravity)*global.grav > 0 &amp;&amp; notOnBlock)&#xd;
    {&#xd;
        var xLast = x;&#xd;
        var yLast = y;&#xd;
        var hLast = hspeed;&#xd;
        var vLast = vspeed;&#xd;
        &#xd;
        vspeed += gravity;&#xd;
        &#xd;
        x += hspeed;&#xd;
        hspeed = 0;&#xd;
        &#xd;
        if(!place_free(x, y+vspeed))&#xd;
        {&#xd;
            if (global.grav == 1)    //Normal&#xd;
                move_contact_solid(270, abs(vspeed));&#xd;
            else    //Flipped&#xd;
                move_contact_solid(90, abs(vspeed));&#xd;
            vspeed = 0;&#xd;
        }&#xd;
        &#xd;
        y += vspeed;            &#xd;
        &#xd;
        if (!place_free(x, y + global.grav) &amp;&amp; place_free(x, y))  //Snapped onto the slope properly&#xd;
        {&#xd;
            djump = 1;&#xd;
            notOnBlock = false;&#xd;
        }&#xd;
        else    //Did not snap onto the slope, return to previous position&#xd;
        {&#xd;
            x = xLast;&#xd;
            y = yLast;&#xd;
            hspeed = hLast;&#xd;
            vspeed = vLast;&#xd;
        }&#xd;
    }&#xd;
    &#xd;
    //Moving down a slope&#xd;
    if (!notOnBlock)&#xd;
    {                                              &#xd;
        var onSlope = (place_meeting(x, y + global.grav, objSlope));    //Treat normal blocks the same as slopes if we're standing on a slope&#xd;
        &#xd;
        slopeCheck = true;&#xd;
        hTest = hspeed;&#xd;
        &#xd;
        while (slopeCheck)&#xd;
        {&#xd;
            ySlope = 0;&#xd;
            //Check how far we should move down&#xd;
            while ((!place_meeting(x + hTest, y - ySlope + global.grav, objSlope) || (onSlope &amp;&amp; place_free(x + hTest, y - ySlope + global.grav))) &amp;&amp; (ySlope*global.grav > -floor(moveLimit * (hTest/hspeed))))&#xd;
            {&#xd;
                ySlope -= global.grav;&#xd;
            }&#xd;
            &#xd;
            //Check if we actually need to move down&#xd;
            if (place_meeting(x + hTest, y - ySlope + global.grav, objSlope) || (onSlope &amp;&amp; place_free(x + hTest, y - ySlope + global.grav)))&#xd;
            {&#xd;
                if (ySlope != 0 &amp;&amp; place_free(x + hTest, y - ySlope))&#xd;
                {&#xd;
                    y -= ySlope;&#xd;
                    &#xd;
                    x += hTest;&#xd;
                    hspeed = 0;&#xd;
                    &#xd;
                    slopeCheck = false;&#xd;
                }&#xd;
                else&#xd;
                {&#xd;
                    if (hTest > 0)&#xd;
                    {&#xd;
                        hTest -= 1;&#xd;
                        if (hTest &lt;= 0)&#xd;
                            slopeCheck = false;&#xd;
                    }&#xd;
                    else if (hTest &lt; 0)&#xd;
                    {&#xd;
                        hTest += 1;&#xd;
                        if (hTest >= 0)&#xd;
                            slopeCheck = false;&#xd;
                    }&#xd;
                    else&#xd;
                    {&#xd;
                        slopeCheck = false;&#xd;
                    }&#xd;
                }&#xd;
            }&#xd;
            else&#xd;
            {&#xd;
                slopeCheck = false;&#xd;
            }&#xd;
        }&#xd;
    }&#xd;
    &#xd;
    //Moving up a slope&#xd;
    if (place_meeting(x + hspeed, y, objSlope))&#xd;
    {                                           &#xd;
        slopeCheck = true;&#xd;
        hTest = hspeed;&#xd;
        &#xd;
        while (slopeCheck)&#xd;
        {&#xd;
            ySlope = 0;&#xd;
            &#xd;
            //Check how far we have to move up&#xd;
            while ( place_meeting(x + hTest, y - ySlope, objSlope) &amp;&amp; (ySlope*global.grav &lt; floor(moveLimit * (hTest/hspeed))) )&#xd;
            {&#xd;
                ySlope += global.grav;&#xd;
            }                                                 &#xd;
            &#xd;
            //Check if we actually need to move up&#xd;
            if (place_free(x + hTest, y - ySlope))&#xd;
            {            &#xd;
                y -= ySlope;&#xd;
                &#xd;
                x += hTest;&#xd;
                hspeed = 0;&#xd;
                &#xd;
                slopeCheck = false;&#xd;
            }&#xd;
            else&#xd;
            {&#xd;
                if (hTest > 0)&#xd;
                {&#xd;
                    hTest -= 1;&#xd;
                    if (hTest &lt;= 0)&#xd;
                        slopeCheck = false;&#xd;
                }&#xd;
                else if (hTest &lt; 0)&#xd;
                {&#xd;
                    hTest += 1;&#xd;
                    if (hTest >= 0)&#xd;
                        slopeCheck = false;&#xd;
                }&#xd;
                else&#xd;
                {&#xd;
                    slopeCheck = false;&#xd;
                }&#xd;
            }&#xd;
        }&#xd;
    }&#xd;
    &#xd;
    //Set xprevious/yprevious coordinates for future solid collisions&#xd;
    xprevious = x;&#xd;
    yprevious = y;&#xd;
}                 &#xd;
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname/>
        <codestring/>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Block collision (Keep this last)&#xd;
&#xd;
vspeed += gravity;&#xd;
&#xd;
if (!place_free(x + hspeed, y + vspeed))&#xd;
{&#xd;
    if (!place_free(x + hspeed, y) &amp;&amp; hspeed != 0)&#xd;
    {&#xd;
        var maxDist = abs(hspeed);&#xd;
        var dir = 180 * (hspeed &lt; 0);&#xd;
        move_contact_solid(dir, maxDist);&#xd;
        &#xd;
        hspeed = 0;&#xd;
    }&#xd;
     &#xd;
    if (!place_free(x, y + vspeed) &amp;&amp; vspeed != 0)&#xd;
    {&#xd;
        var maxDist = abs(vspeed);&#xd;
        var dir = 270 - 180 * (vspeed &lt; 0);&#xd;
        move_contact_solid(dir, maxDist);&#xd;
        &#xd;
        if (dir == 180 + global.grav * 90)&#xd;
            { djump = 1; }&#xd;
        vspeed = 0;&#xd;
    }&#xd;
    &#xd;
    if (!place_free(x + hspeed, y + vspeed))&#xd;
    {&#xd;
        //hspeed = 0;&#xd;
        //Traditional behavior when resolving corner collision is to stop hspeed. When on a platform, this can cause horizontal stutter, so we stop vspeed instead.&#xd;
        var p = instance_place(x, y+vspeed, objPlatform);&#xd;
        if (!p || place_meeting(x, y, p))&#xd;
        {&#xd;
            hspeed = 0;&#xd;
        }&#xd;
        else&#xd;
        {&#xd;
            vspeed = 0;&#xd;
        }&#xd;
    }&#xd;
}&#xd;
&#xd;
xsafe = x + hspeed;&#xd;
ysafe = y + vspeed;&#xd;
&#xd;
vspeed -= gravity;&#xd;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="4" ename="objPlatform">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname/>
        <codestring/>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Land on platforms, get snapped&#xd;
//Being carried upwards is handled in objPlatform&#xd;
&#xd;
if (global.grav == 1)    //Normal&#xd;
{&#xd;
    var landedOnPlatform = bbox_bottom - vspeed - 1 &lt;= other.bbox_top - min(other.vspeed, 0);&#xd;
    var jumpedOut = bbox_bottom + vspeed &lt;= other.bbox_top + other.vspeed;&#xd;
    &#xd;
    if (landedOnPlatform || (jumpedOut &amp;&amp; other.snap))&#xd;
    {&#xd;
        var yy = other.y - (bbox_bottom - y) - 1;&#xd;
        if (!global.platformsPhase)&#xd;
        {&#xd;
            move_contact_solid(90, y - yy); //Move against solid to not get snapped into a wall&#xd;
        }&#xd;
        else&#xd;
        {&#xd;
            y = yy;&#xd;
            ysafe = y;&#xd;
        }&#xd;
        vspeed = max(other.vspeed, 0);&#xd;
        &#xd;
        onPlatform = true;&#xd;
        djump = 1;&#xd;
    }&#xd;
}&#xd;
else    //Flipped&#xd;
{&#xd;
    var landedOnPlatform = bbox_top - vspeed + 1 >= other.bbox_bottom - max(other.vspeed, 0);&#xd;
    var jumpedOut = bbox_top + vspeed >= other.bbox_bottom + other.vspeed;&#xd;
    &#xd;
    if (landedOnPlatform || (jumpedOut &amp;&amp; other.snap))&#xd;
    {&#xd;
        var yy = other.y + other.sprite_height + (y - bbox_top);&#xd;
        if (!global.platformsPhase)&#xd;
        {&#xd;
            move_contact_solid(270, yy - y);&#xd;
        }&#xd;
        else&#xd;
        {&#xd;
            y = yy;&#xd;
            ysafe = y;&#xd;
        }&#xd;
        vspeed = min(other.vspeed, 0);&#xd;
        &#xd;
        onPlatform = true;&#xd;
        djump = 1;&#xd;
    }&#xd;
} &#xd;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event enumb="4" eventtype="7">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname/>
        <codestring/>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Autosave

if (global.autosave) //Save the game if currently set to autosave
{
    scrSaveGame(true);
    global.autosave = false;
}

var Field = instance_create(x,y,objMagicField);
Field.playerID = PlayerID;
Field.followID = id;

botMode = global.playerBotMode[PlayerID];
//botMode = true;
//if (PlayerID == 1) botMode = true;</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event enumb="0" eventtype="8">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname/>
        <codestring/>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Draw the player

var drawX = floor(x + 0.5);
var drawY = floor(y + 0.5);
var drawAlpha = 1;

if (global.grav == -1)      //Need to draw the player a pixel off in the y-axis when flipped for some reason
    { drawY += 1; }

drawAlpha -= (iframes > 0) * 0.5;

draw_sprite_ext(sprite_index, image_index, drawX, drawY, image_xscale * xScale, image_yscale * global.grav, image_angle, image_blend, image_alpha * drawAlpha);

//Draw the player's hitbox
if (global.debugShowHitbox){
    draw_sprite_ext(mask_index, image_index, x, y, image_xscale, image_yscale, image_angle, image_blend, image_alpha * 0.8);

    var bulletParent = instance_nearest(x, y, objPlayerKiller);
    if (bulletParent != noone){
        var bulletDis = point_distance(x, y, bulletParent.x, bulletParent.y);
        
        var Color = scrTernary(bulletDis &lt; botDistance,make_colour_hsv(current_time/16,255,255),c_black);
        draw_set_colour(Color);
        draw_line(x,y,bulletParent.x,bulletParent.y);
    }
}</string>
          </argument>
        </arguments>
      </action>
    </event>
