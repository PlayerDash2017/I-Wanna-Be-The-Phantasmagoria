        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>mainScale = Scale;
Bye = true;</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
  <PhysicsShapePoints/>
