  <events>
    <event enumb="0" eventtype="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <exetype>2</exetype>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <functionname/>
        <codestring/>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>image_speed = 1/10;
image_xscale = 0;
image_yscale = image_xscale;

Scale = 0.5;
alarm[0] = 60;</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event enumb="0" eventtype="3">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <exetype>2</exetype>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <functionname/>
        <codestring/>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>image_xscale = lerp(image_xscale,Scale,0.2);
image_yscale = image_xscale;

var Dis = image_xscale * 100;
x = xstart + lengthdir_x(Dis,Angle);
y = ystart + lengthdir_y(Dis,Angle);

Angle += 5;

if (Dis &lt;= 0.1 &amp;&amp; Scale == 0){
    instance_destroy();
}</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event enumb="0" eventtype="2">
      <action>
        <libid>1</libid>
