    break;
    case 4:
        for (var i = 0; i &lt; 360; i += 360/4) {
            var a = instance_create(x,y,objCherryBullet);
            a.speed = 4;
            a.direction = i + Dir;
            a.sprite_index = sprite_index;
        }

        Dir += 19;
        
        alarm[0] = 10;
    break;
    case 3:
        repeat (2){
            var a = instance_create(x,y,objCherryBulletYellow);
            a.speed = random_range(8,13);
            a.direction = 90 + irandom(45);
            a.gravity = 0.18;
            a.sprite_index = sprite_index;
            a.alarm[0] = 40;
        }
        
        alarm[0] = 40;
    break;
    case 2:
        for (var i = 0; i &lt;= battle_width; i += battle_width/2) {
            var a = instance_create_battle(i,0,objCherryBullet);
            a.hspeed = random_range(-4,4);
            a.gravity = random_range(0.18,0.23);
            a.sprite_index = sprite_index;
        }
        
        alarm[0] = 8;
    break;
    case 1:
        repeat (2){
            var a = instance_create(x,y,objCherryBullet);
            a.speed = random_range(4,6);
            a.direction = irandom(360);
            a.sprite_index = sprite_index;
            a.image_blend = make_color_hsv(random(255), 255, 255)
        }
        
        alarm[0] = 5;
    break;
}</string>
