            <string>iframes = max(iframes - 1,0);
HP = global.playerHP[!scrGetPlayerID()];

if (!extraPhase) {
    if (HP != preHP)
        { event_user(0); }
} else {
    if (extraHP &lt;= 0) {
        event_user(0);
        
        extraPhase = false;
    }
}


preHP = HP;</string>
