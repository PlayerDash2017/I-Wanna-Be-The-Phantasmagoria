  <PhysicsObjectAngularDamping>0.1</PhysicsObjectAngularDamping>
  <PhysicsObjectFriction>0.2</PhysicsObjectFriction>
  <PhysicsObjectAwake>-1</PhysicsObjectAwake>
  <PhysicsObjectKinematic>0</PhysicsObjectKinematic>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <exetype>2</exetype>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <functionname/>
        <codestring/>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>image_speed = 0;
hspeed = -3;

bullet = noone;
XX = scrGetPlayerID()*1280;

setColor[0] = c_white;
setColor[1] = c_blue;
setColor[2] = c_purple;
setColor[3] = c_yellow;
setColor[4] = c_red;
setColor[5] = c_aqua;</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="4" ename="objBullet">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <exetype>2</exetype>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <functionname/>
        <codestring/>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>instance_destroy(other);

if (!instance_exists(bullet)){
    bullet = instance_create(x,y,objShiratamaDamage);
    
    var followID = objWorld;
    var A = scrGetPlayerID();
    
    if (image_index != 0){
        with(objShiratamaPhase){
            if (scrGetPlayerID() == A &amp;&amp; Phase == other.image_index){
                followID = id;
            }
        }
    } else {
        with(objShiratamaBossMain){
            if (scrGetPlayerID() == A){
                followID = id;
            }
        }
    }
    
    bullet.target = followID;
    bullet.direction = point_direction(x,y,followID.x,followID.y);
    bullet.speed = 9;
    bullet.image_blend = setColor[image_index];
}</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="2">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <exetype>2</exetype>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <functionname/>
        <codestring/>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>x = scrWrapInRange(x,XX,XX+640);</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
  <PhysicsShapePoints/>
