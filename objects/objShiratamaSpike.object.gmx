<object>
  <spriteName>sprShiratamaSpike</spriteName>
  <parentName>objPlayerKiller</parentName>
  <maskName>&lt;undefined></maskName>
  <solid>0</solid>
  <visible>-1</visible>
  <depth>1005</depth>
  <persistent>0</persistent>
  <PhysicsObject>0</PhysicsObject>
