            <string>var Bullet = instance_place(x, y, objBossBulletParent);

if (Bullet != noone){
    var BossType = &quot;&quot;;
    switch (global.charSelect[!scrGetPlayerID()]) {
        case 0: //Big Cherry
            BossType = &quot;BigCherry&quot;;
        break;
        case 1: //Hatsune Miku
            BossType = &quot;Miku&quot;;
        break;
        case 2: //The Colonel
            BossType = &quot;Colonel&quot;;
        break;
        case 3: //Big Kid
            BossType = &quot;BigKid&quot;;
        break;
        case 4: // Kurodama
            BossType = &quot;Kurodama&quot;;
        break;
    }

    scrEnemyBullet(&quot;Magic_&quot;+BossType, 1);
    event_user(0);
    instance_destroy(Bullet);
}</string>
          </argument>
        </arguments>
      </action>
