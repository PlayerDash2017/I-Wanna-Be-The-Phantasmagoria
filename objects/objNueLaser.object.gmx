  <events>
    <event enumb="1" eventtype="2">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <exetype>2</exetype>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <functionname/>
        <codestring/>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>for (var i = 16; i &lt; battle_height; i += 32)
{
    a = instance_create(x,800+i,objNueBulletLaser);
    a.Type = floor(i/32) mod 4;//(Type * 2 + floor(i/32)) mod 4;//Type * 2 + (floor(i/32) mod 2);
}

visible = false;
alarm[2] = 125;</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event enumb="0" eventtype="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <exetype>2</exetype>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <functionname/>
        <codestring/>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>Kill = false;
Dis = false;
image_alpha = 0;

alarm[0] = 100;
bossMain = objBossParent;

image_yscale = battle_height/32;</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event enumb="0" eventtype="3">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <exetype>2</exetype>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <functionname/>
        <codestring/>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (Dis){
    mask_index = sprEmpty;
    Kill = false;
    alarm[0] = 0;
    alarm[1] = 0;
    alarm[2] = 0;
    image_alpha -= 0.01;
    if (image_alpha &lt;= 0) instance_destroy();
    
    exit;
}

image_alpha = min(image_alpha + 1/30,1);
image_xscale = min(image_xscale + 1/30,1);</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event enumb="0" eventtype="8">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <exetype>2</exetype>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <functionname/>
        <codestring/>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>draw_sprite_ext(sprite_index,0,x,y,image_xscale,image_yscale,0,c_white,image_alpha - 0.5 * !Kill)</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event enumb="0" eventtype="2">
      <action>
        <libid>1</libid>
        <id>603</id>
