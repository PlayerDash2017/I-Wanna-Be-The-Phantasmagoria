          <argument>
            <kind>1</kind>
            <string>var XX = 0;
var YY = 0;
var W = (battle_width-32)/5;
//scrPrint("Type:",Type);
switch (Type)
{
    case 0:
        XX = x+W;
        YY = y+64;
    break;
    case 1:
        XX = x+W;
        YY = y-64;
    break;
    case 2:
        XX = x-W;
        YY = y+64;
    break;
    case 3:
        XX = x-W;
        YY = y-64;
    break;
    default:
        scrPrint("What?",Type);
}

direction = point_direction(x,y,XX,YY);
speed = point_distance(x,y,XX,YY)/75;
alarm[1] = 75;</string>
          </argument>
