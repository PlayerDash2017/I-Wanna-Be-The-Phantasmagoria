        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Next Attack

switch (HP) {
    case 5:
        alarm[0] = 50;
    break;
    case 4: case 2:
        alarm[1] = 1;
    break;
    case 3:
        var A = scrGetPlayerID();
        with(objMikuBlock){
            if (scrGetPlayerID() == A &amp;&amp; y == 800+battle_height-32){
                alarm[0] = 100;
            }
        }
        
        with(objMikuBullet){
            if (scrGetPlayerID() == A)
                { Dis = true; }
        }

        with(objMikuBulletCircle){
            if (scrGetPlayerID() == A)
                { Dis = true; }
        }
        
        with(objPlayer){
            if (PlayerID == A){
                botState = "Miku_NoFloor";
            }
        }

        alarm[0] = 50;
        alarm[1] = -1;
    break;
    case 1:
        var A = scrGetPlayerID();
        with(objMikuBlock){
            if (scrGetPlayerID() == A){
                alarm[0] = 100;
            }
        }

        with(objMikuBullet){
            if (scrGetPlayerID() == A)
                { Dis = true; }
        }
        with(objMikuBulletLeek){
            if (scrGetPlayerID() == A)
                { Dis = true; }
        }
        with(objMikuBulletWave){
            if (scrGetPlayerID() == A)
                { instance_destroy(); }
        }
        
        with(objPlayer){
            if (PlayerID == A){
                botState = "InfJump";
            }
        }

        global.infJump[scrGetPlayerID()] = true;

        alarm[0] = 50;
        alarm[1] = -1;
    break;
    case 0:
        instance_destroy();
        
        var A = scrGetPlayerID();
        with(objMikuBullet){
            if (scrGetPlayerID() == A)
                { Dis = true; }
        }
        
        if (extraPhase) event_user(4);
    break;
}</string>
