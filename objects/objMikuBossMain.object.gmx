        <arguments>
          <argument>
            <kind>1</kind>
            <string>switch (HP) {
    case 4: case 5:
        var Ran = irandom(360);
        var XX = irandom_range(40,battle_width-40);
        var YY = irandom_range(40,70);
        var Color = irandom_range(sprCherry,sprCherryPink);
        for (var i = 0; i &lt; 360; i += 360/8) {
            var a = instance_create_battle(XX, YY, objMikuBulletCircle);
            a.speed = 2;
            a.direction = i + Ran;
            a.friction = 0.1;
            a.sprite_index = Color;
        }

        alarm[1] = 75;
    break;
    case 3: case 2:
        a = instance_create_battle(battle_width, battle_height, objMikuBulletWave);
        a.hspeed = -2.5;
        a.alarm[1] = battle_width/abs(a.hspeed);
        a.sprite_index = irandom_range(sprCherryAzure,sprCherryBlue);
        
        alarm[1] = 170;
    break;
}</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="2" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
