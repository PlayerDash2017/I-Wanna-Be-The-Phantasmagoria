        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (extraPhase){
    var a = instance_create_battle(battle_width, irandom(battle_height), objMikuBulletBig);
    a.hspeed = -random_range(4,5);
    a.alarm[0] = 10;
    a.sprite_index = irandom_range(sprCherry,sprCherryPink);

    alarm[0] = 10;
    exit;
}

switch (HP) {
    case 5: case 4:
        var a = scrMakeShapes(x, y, irandom(360), 4, irandom_range(3,4), random_range(4,6), objMikuBullet);

        var Color = irandom_range(sprCherry,sprCherryPink);
        for (var i = 0; i &lt; array_length_1d(a); i += 1) {
            a[i].sprite_index = Color;
        }

        alarm[0] = 30;
    break;
    case 2: case 3:
        var a = instance_create_battle(battle_width, irandom(battle_height), objMikuBulletLeek);
        a.speed = random_range(3,5);
        a.direction = 180 + irandom_range(-20,20);

        alarm[0] = 10;
    break;
    case 1:
        var a = instance_create_battle(536, 112, objMikuBullet);
        a.speed = random_range(3,5);
        a.direction = 180 + irandom_range(-20,80);
        a.Dir = random_range(-1,1);
        a.image_xscale = random_range(0.5,1);
        a.image_yscale = a.image_xscale;
        a.sprite_index = irandom_range(sprCherry,sprCherryPink);

        alarm[0] = 5;
    break;
}</string>
          </argument>
        </arguments>
      </action>
