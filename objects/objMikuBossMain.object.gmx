        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Level 3
event_inherited();

extraHP = 8;

with(Negative) instance_destroy();
Negative = instance_create_battle(0, 0, objMikuNegativeEff);
image_index = 1;

var A = scrGetPlayerID();
with(objMikuBullet){
    if (scrGetPlayerID() == A)
        { Dis = true; }
}
with(objMikuBulletCircle){
    if (scrGetPlayerID() == A)
        { Dis = true; }
}
with(objMikuBulletLeek){
    if (scrGetPlayerID() == A)
        { Dis = true; }
}
with(objMikuBulletWave){
    if (scrGetPlayerID() == A)
        { instance_destroy(); }
}

alarm[0] = 5;
alarm[1] = -1;</string>
          </argument>
        </arguments>
      </action>
