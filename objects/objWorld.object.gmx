            <kind>1</kind>
            <string>///Initialize everything&#xd;
&#xd;
scrInitializeGlobals();&#xd;
scrLoadConfig();&#xd;
&#xd;
if (global.checkForUpdates)&#xd;
{&#xd;
    global.httpUpdateCheck = http_get(global.versionDataUrl);&#xd;
    updateString = "";&#xd;
}&#xd;
&#xd;
volumeTimer = 0;&#xd;
volumeDelay = 10;&#xd;
&#xd;
room_goto_next();&#xd;
</string>
