        <arguments>
          <argument>
            <kind>1</kind>
            <string>switch (Boss) {
    case "BigCherry":
        var a = instance_create(x, y, objCherryBullet);
        a.gravity = 0.14;
        a.hspeed = random_range(-1,1);
        a.vspeed = -1;
    break;
    case "Magic_BigCherry":
        var a = instance_create(x, y, objCherryBullet);
        a.speed = 3;
        a.friction = -0.1;
        a.direction = 270 + irandom_range(-50,50);
    break;

    case "Miku":
        var Ran = irandom(360);
        for (var i = 0; i &lt; 360; i += 360/15) {
            var a = instance_create(x, y, objMikuBulletGlow);
            a.speed = 7;
            a.direction = i + Ran;
        }
    break;
    case "Magic_Miku":
        var XX = scrGetPlayerID() * 1280;
        var YY = 800;

        var a = instance_create(x, y, objMikuBulletLeek);
        a.speed = 6;
        a.direction = point_direction(x, y, XX + battle_width/2, YY + battle_height/2) + irandom_range(-20,20);
        a.Dir = random_range(-1,1);
    break;

    case "Colonel":
        var a = instance_create(x,y,objColonelBullet);
        a.speed = 0.1;
        a.friction = -0.02;
        a.direction = irandom(360);
        a.sprite_index = sprBulletKunai;
        a.image_index = 9;
    break;
    case "Magic_Colonel":
        var a = instance_create(x,y,objColonelBulletYellow);
        a.speed = 1;
        a.direction = 270+irandom_range(-80,80);
    break;

    case "BigKid":
        var a = instance_create(x,y,objBigKidCherry);
        a.vspeed = 4;
    break;
    case "Magic_BigKid":
        var XX = scrGetPlayerID() * 1280 + battle_width/2;
        var a = instance_create(x,y,objBigKidCherry);
        a.hspeed = sign(x - XX) * -4;
    break;

    case "Kurodama":
        var a = instance_create(x, y, objKurodamaCherryFire);
        a.gravity = 0.1;
    break;
    case "Magic_Kurodama":
        var a = instance_create(x, y, objKurodamaFireBlock);
        a.gravity = 0.1;
    break;
    
    case "ShiratamaRed":
        for (var i = 3; i &lt;= 5; ++i){
            var a = instance_create(x,y,objShiratamaCherry);
            a.direction = point_direction(x,y,scrPX(),scrPY());
            a.speed = i;
            a.sprite_index = sprCherry;
        }
    break;
    case "ShiratamaPurple":
        var XX = 0;
        repeat(2){
            var a = instance_create_battle(XX,0,objShiratamaCherry);
            a.direction = point_direction(a.x,a.y,scrPX(),scrPY());
            a.speed = 5;
            a.sprite_index = sprCherryMagenta;
            
            XX += battle_width;
        }
    break;
    case "ShiratamaYellow":
        var a = instance_create(x,y,objShiratamaCherryYellow);
        a.direction = 270 + irandom_range(-60,60);
        a.speed = random_range(3,4);
    break;
    case "ShiratamaBlue":
        var a = instance_create(x,y,objShiratamaCherry);
        a.speed = random_range(3,6);
        a.direction = random_range(40,140);
        a.image_xscale = 1.5;
        a.image_yscale = a.image_xscale;
        a.gravity = random_range(0.07,0.2);
        a.sprite_index = sprCherryBlue;
    break;
    case "ShiratamaAqua":
        repeat(5){
            var a = instance_create(x,y,objShiratamaCherry);
            a.sprite_index = sprCherryCyan;
            a.speed = random_range(2,4);
            a.direction = point_direction(x,y,scrPX(),scrPY()) + irandom_range(-90,90);
            a.image_xscale = random_range(0.5,1);
            a.image_yscale = a.image_xscale;
        }
    break;
    case "Shiratama": case "Magic_Shiratama":
        var a = instance_create(x,y,objShiratamaCherry);
        a.speed = random_range(1,3);
        a.direction = irandom(360);
        a.sprite_index = sprCherryWhite;
        a.image_blend = make_colour_hsv(random(255),255,255);
    break;
}

instance_destroy();</string>
