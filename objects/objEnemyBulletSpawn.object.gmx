            <string>switch (Boss) {
    case "BigCherry":
        xSpawn = irandom_range(30,battle_width-30);
        ySpawn = irandom_range(50,100);
    break;
    case "Magic_BigCherry":
        xSpawn = irandom_range(30,battle_width-30);
        ySpawn = irandom_range(50,100);
    break;

    case "Miku":
        xSpawn = irandom_range(30,battle_width-30);
        ySpawn = 32;
    break;
    case "Magic_Miku":
        xSpawn = battle_width * irandom(1);
        ySpawn = 0;
    break;

    case "Colonel":
        xSpawn = battle_width/2 + irandom_range(-20,20);
        ySpawn = battle_height/2 + irandom_range(-20,20);
    break;
    case "Magic_Colonel":
        xSpawn = battle_width/2;
        ySpawn = 0;
    break;

    case "BigKid":
        xSpawn = irandom(battle_width);
        ySpawn = 0;
    break;
    case "Magic_BigKid":
        xSpawn = battle_width * irandom(1);
        ySpawn = irandom(battle_height);
    break;

    case "Kurodama": case "Magic_Kurodama":
        xSpawn = floor(irandom_range(32,battle_width-32)/32)*32 + 16;
        ySpawn = 0;
    break;
    
    case "ShiratamaBlue":
        xSpawn = battle_width/2;
        ySpawn = 200;
    break;
    case "ShiratamaPurple":
        xSpawn = irandom(1) * battle_width;
        ySpawn = 0;
    break;
    case "ShiratamaYellow":
        xSpawn = irandom_range(32,battle_width-32);
        ySpawn = irandom(100);
    break;
    case "ShiratamaRed":
        xSpawn = irandom(battle_width);
        ySpawn = 0;
    break;
    case "ShiratamaAqua":
        xSpawn = battle_width/2 + irandom_range(50,50);
        ySpawn = 150 + irandom_range(-50,50);
    break;
    case "Shiratama": case "Magic_Shiratama":
        xSpawn = irandom(battle_width);
        ySpawn = irandom(100);
    break;

    default:
        show_debug_message(Boss);
}</string>
